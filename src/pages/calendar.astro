---
import MonthObservanceDays from "../components/MonthObservanceDays.astro";
import Social from "../components/Social.astro";
import Layout from "../layouts/Layout.astro";
import {
  getCurrentMonth,
  getNextMonth,
  getPreviousMonth,
} from "../utils/observanceDays";

const currentMonth = getCurrentMonth();
const previousMonth = getPreviousMonth(currentMonth);
const nextMonth = getNextMonth(currentMonth);
---

<Layout
  title={`${currentMonth.name} Calendar`}
  description={`Environmental and sustainability observance days for ${currentMonth.name}. Don't miss the important environmental days.`}
  activePage="calendar"
>
  <div class="p-4 lg:ml-24 sm:mb-16 lg:mb-0">
    <article>
      <h1 class="text-center font-bold text-3xl md:text-5xl mt-8">Observance Days Calendar</h1>
      <p class="text-center text-md lg:text-xl xl:text-2xl mt-2">
        Don't miss the important environmental days..
        <br />
        In case you did, we're here to remind you 💚
      </p>

      <h3 class="text-center cursor-pointer mt-4 text-lg lg:text-xl xl:text-2xl">
        <a
          href="/observance-days-api"
          class="text-secondary no-underline hover:text-primary"
          >Observance Days API</a
        >
      </h3>

      <br />

      <h2 class="text-center font-bold text-2xl md:text-4xl mt-4">
        {currentMonth.name}
      </h2>

      <div class="flex justify-center gap-4 mt-4 mb-8">
        <a
          href={`/calendar/${previousMonth.slug}`}
          class="text-secondary hover:text-primary font-semibold"
        >
          ← {previousMonth.name}
        </a>
        <a
          href={`/calendar/${nextMonth.slug}`}
          class="text-secondary hover:text-primary font-semibold"
        >
          {nextMonth.name} →
        </a>
      </div>

      <MonthObservanceDays days={currentMonth.days} />

      <br />
      <br />

      <div>
        <Social />
      </div>
    </article>
  </div>
</Layout>
